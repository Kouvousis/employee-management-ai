# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real credentials.

# --- Database credentials ---
# The bundled Postgres container (docker-compose `db` service) is initialized
# with these. Choose your own. They only apply when the data volume is first
# created; run `docker compose down -v` to re-initialize with new values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=novatech

# --- Database connection (used by the backend) ---
# user / password / db below MUST match the POSTGRES_* values above.
# Host:
#   - bundled Docker database (docker compose):   db
#   - backend running directly on your machine:   localhost
# A `@` in the password must be percent-encoded as %40.
DATABASE_URL=postgresql+psycopg://postgres:change_me@db:5432/novatech

DEVELOPMENT_MODE=true

# --- API keys ---
# Required: used for embeddings (always) and as the default LLM.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: LLM fallback when OPENAI_API_KEY is absent.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Auth ---
# Required: secret used to sign JWTs.
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480